# Pick a long random password. Keep this file private.
DB_PASSWORD=replace-with-a-long-random-alphanumeric-password
# Absolute host path containing media. Mounted read-only inside Movana.
MEDIA_PATH=/absolute/path/to/media
# Loopback by default. To access over LAN set to your NAS LAN IP, and restrict access.
MOVANA_BIND_IP=127.0.0.1
MOVANA_PORT=8088
\n# Optional: required only to load TMDb-supported title languages.\nTMDB_READ_ACCESS_TOKEN=\nTMDB_API_KEY=\n